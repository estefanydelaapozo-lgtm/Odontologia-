PORT=3000
API_PORT=3000
FRONTEND_PORT=5173
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgres://sigo:sigo_dev@localhost:5432/sigo_dental?sslmode=disable
DB_MAX_OPEN_CONNS=150
DB_MAX_IDLE_CONNS=30
JWT_SECRET=replace-this-with-a-long-random-secret-32-chars-minimum
DATA_ENCRYPTION_KEY=BASE64_OF_32_RANDOM_BYTES_CHANGE_BEFORE_USE
ADMIN_EMAIL=admin@odontologia.local
ADMIN_PASSWORD=change-me-now
FRONTEND_ORIGIN=http://localhost:5173
TLS_CERT_FILE=
TLS_KEY_FILE=
MESSAGING_API_URL=
MESSAGING_API_TOKEN=
# whatsapp, email, sms o all
REMINDER_CHANNEL=whatsapp
CONSENT_OTP_CHANNEL=email
# WhatsApp Cloud API: approved template must have one body text parameter.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_API_VERSION=v21.0
# Twilio SMS (phone numbers in E.164 format).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# SMTP always requires STARTTLS; username/password are optional as a pair.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TIMEOUT_SECONDS=10
CLINICAL_STORAGE_DIR=./var/clinical
CLINICAL_NOTE_EDIT_HOURS=24
FISCAL_API_URL=
FISCAL_API_TOKEN=
PAYMENT_API_URL=
PAYMENT_API_TOKEN=
PAYMENT_WEBHOOK_SECRET=


# Solo para pruebas locales; desactivar en producción
ENABLE_DEMO_USERS=false
# Carga pacientes, agenda, cobros, planes e inventario ficticios (ver controllers/demo_data.go). Solo local.
ENABLE_DEMO_DATA=false
CLINIC_TZ=America/Guayaquil
